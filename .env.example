DATABASE_URL="postgres://postgres:password@localhost:5432/postgres?sslmode=disable"
PORT=3000
APP_ENV=development

# Local media cache root (game images/trailers served at MEDIA_BASE_URL)
MEDIA_DIR="media"
MEDIA_BASE_URL="/media"

# Host port for the local Postgres container (change if 5432 is taken)
POSTGRES_PORT=5432

# password for the compose db service and the prod app DATABASE_URL.
# Only used on first db init / by the app container; safe to leave unset.
#POSTGRES_PASSWORD=postgres

# --- IGDB (optional; enable `gems igdb sync|catalogue`) --------------------
# Confidential app credentials from https://dev.twitch.tv/console/apps
#IGDB_CLIENT_ID=
#IGDB_CLIENT_SECRET=

# --- Newsletter ------------------------------------------------------------
# Public origin of the site; all links and image URLs in emails are absolute
# against it.
BASE_URL="http://localhost:3000"

# SMTP relay. Defaults point at the local Mailpit dev sink (docker compose
# up -d mailpit; UI at http://localhost:8025). For production use a
# transactional provider's SMTP relay (Postmark/SES/Resend).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# none | starttls | tls (implicit TLS, 465-style)
SMTP_TLS=none
# Max mails per second
SMTP_RATE_PER_SEC=10

# Sender identity. From must be a single RFC 5322 address.
MAIL_FROM="Indie Game Gems <gems@example.com>"
MAIL_REPLY_TO=
# Physical postal address shown in every bulk mail footer (CAN-SPAM/imprint).
MAIL_POSTAL_ADDRESS="Indie Game Gems, 1 Gem Way, 12345 Gemtown"

# HMAC secret for unsubscribe links. Rotating it invalidates all outstanding
# unsubscribe links — generate once, e.g.: openssl rand -hex 32
NEWSLETTER_SECRET="dev-secret-change-me"
