package email

// ConfirmPage renders the double-opt-in confirmation mail. Transactional,
// so: no bulk headers and no unsubscribe footer — just the confirm button,
// the plain link (clients that block buttons/styling), and what to do if
// the recipient never signed up.
templ ConfirmPage(doc ConfirmDoc) {
	<!DOCTYPE html>
	<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<meta name="supported-color-schemes" content="light dark"/>
			<title>Confirm your Indie Game Gems subscription</title>
		</head>
		<body style="margin:0;padding:0;background-color:#efe9df;color:#2b2622;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;line-height:1.5;">
			<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#efe9df;">
				<tr>
					<td align="center" style="padding:24px 12px;">
						<table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;background-color:#fdfaf3;border:1px solid #e3d9c6;border-radius:16px;overflow:hidden;">
							<tr>
								<td style="padding:28px 24px 8px 24px;">
									@wordmark(doc.HomeURL)
								</td>
							</tr>
							<tr>
								<td style="padding:8px 24px 24px 24px;">
									<h1 style="margin:0 0 12px 0;font-size:20px;">One click and you&#8217;re in</h1>
									<p style="margin:0 0 16px 0;color:#4a4438;font-size:15px;">
										Confirm your email address to start getting Indie Game Gems — one great indie game a day, plus the weekly release radar.
									</p>
									<p style="margin:0 0 16px 0;">
										<a href={ templ.URL(doc.ConfirmURL) } style="display:inline-block;padding:12px 22px;background-color:#8b3fe6;color:#fdfaf3;font-size:15px;font-weight:600;text-decoration:none;border-radius:999px;">Confirm my subscription</a>
									</p>
									<p style="margin:0 0 16px 0;color:#4a4438;font-size:14px;">Or paste this link into your browser:</p>
									<p style="margin:0 0 16px 0;"><a href={ templ.URL(doc.ConfirmURL) } style="color:#8b3fe6;font-size:13px;word-break:break-all;">{ doc.ConfirmURL }</a></p>
									<p style="margin:0;color:#6f675c;font-size:13px;">{ doc.Reason }</p>
								</td>
							</tr>
							<tr>
								<td style="padding:0 24px 28px 24px;">
									<div style="border-top:1px solid #e3d9c6;padding-top:16px;color:#6f675c;font-size:12px;line-height:1.6;">
										if doc.PostalAddress != "" {
											<p style="margin:0;">Indie Game Gems &#183; { doc.PostalAddress }</p>
										}
									</div>
								</td>
							</tr>
						</table>
					</td>
				</tr>
			</table>
		</body>
	</html>
}
