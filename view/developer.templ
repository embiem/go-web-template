package view

import (
	"strconv"
	"strings"

	"github.com/embiem/indie-game-gems/util"
)

templ DeveloperPage(d DeveloperPageData) {
	@Layout(d.Meta) {
		<section class="border-b border-white/5 bg-night-900/40">
			<div class="container-site py-12 sm:py-16">
				<div class="flex flex-col gap-6 sm:flex-row sm:items-center">
					if d.Developer.LogoKey != "" {
						<img
							src={ MediaURL(d.Developer.LogoKey) }
							alt={ d.Developer.Name + " logo" }
							width="96"
							height="96"
							loading="lazy"
							class="h-24 w-24 shrink-0 rounded-2xl object-cover ring-1 ring-white/15"
						/>
					} else {
						<div class="flex h-24 w-24 shrink-0 items-center justify-center rounded-2xl ring-1 ring-white/15" style={ TileGradient(d.Developer.Slug) }>
							<span class="font-display text-3xl font-bold text-white/90">{ initial(d.Developer.Name) }</span>
						</div>
					}
					<div class="min-w-0">
						<h1 class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">{ d.Developer.Name }</h1>
						<div class="mt-3 flex flex-wrap items-center gap-2 text-sm">
							if d.Developer.WebsiteUrl != "" {
								<a href={ d.Developer.WebsiteUrl } target="_blank" rel="noopener" class="inline-flex min-h-9 items-center rounded-full bg-white/5 px-3 py-1.5 font-medium text-zinc-200 ring-1 ring-white/10 transition ring-inset hover:bg-white/10">
									Website ↗
								</a>
							}
							for _, s := range d.Socials {
								<a href={ s.URL } target="_blank" rel="noopener" class="inline-flex min-h-9 items-center rounded-full bg-white/5 px-3 py-1.5 font-medium text-zinc-300 ring-1 ring-white/10 transition ring-inset hover:bg-white/10 hover:text-white">
									{ s.Label } ↗
								</a>
							}
						</div>
					</div>
				</div>
				if d.Developer.BioMd != "" {
					<div class="prose-gem mt-6 max-w-3xl">
						@templ.Raw(util.MdToHTML(d.Developer.BioMd))
					</div>
				}
			</div>
		</section>

		<section class="container-site mt-12" aria-labelledby="dev-games-h">
			<h2 id="dev-games-h" class="font-display text-2xl font-bold text-white">
				Games by { d.Developer.Name }
				<span class="ml-1 text-base font-normal text-zinc-500">{ lenLabel(len(d.Games)) }</span>
			</h2>
			<div class="mt-6">
				if len(d.Games) > 0 {
					@GameCardGrid(d.Games)
				} else {
					@EmptyState("Nothing here yet", "We haven't catalogued any games for this developer so far.", "/", "Back to the front page")
				}
			</div>
		</section>
	}
}

// initial returns the first rune of a name for the logo fallback tile.
func initial(name string) string {
	return strings.ToUpper(name[:1])
}

func lenLabel(n int) string {
	if n == 1 {
		return "(1 game)"
	}
	return "(" + strconv.Itoa(n) + " games)"
}
