package view

templ NotFoundPage() {
	@Layout(PageMeta{
		Title:       "Page not found",
		Description: "This page could not be found.",
		Canonical:   "/404",
		NoIndex:     true,
	}) {
		<section class="container-site flex flex-col items-center py-24 text-center sm:py-32">
			<div class="relative">
				@GemMark("h-16 w-16 opacity-90")
				<span class="absolute -right-6 -bottom-2 rotate-12 rounded-lg bg-gem-600 px-2 py-0.5 font-display text-sm font-bold text-white shadow-lg">404</span>
			</div>
			<h1 class="mt-8 font-display text-3xl font-bold text-white sm:text-4xl">This gem is still unpolished</h1>
			<p class="mt-3 max-w-md text-zinc-400">
				The page you're looking for doesn't exist — maybe a mistyped slug, or a pick that hasn't happened yet.
			</p>
			<div class="mt-8 flex flex-wrap justify-center gap-3">
				<a href="/" class={ ButtonClass("", "lg", "") }>Back to the front page</a>
				<a href="/game-of-the-day" class={ ButtonClass("secondary", "lg", "") }>Today's gem</a>
			</div>
		</section>
	}
}
