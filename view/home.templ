package view

import "strconv"

templ HomePage(d HomePageData) {
	@Layout(d.Meta) {
		if d.Pick != nil {
			@PickHero(*d.Pick, true)
		} else {
			<div class="container-site pt-12">
				@EmptyState(
					"The first gem is being polished",
					"No Game of the Day has been published yet. Check back soon — or browse this week's release radar below.",
					"/release-radar",
					"Open the Release Radar",
				)
			</div>
		}

		if len(d.Radar.Cards) > 0 {
			<section class="container-site mt-16" aria-labelledby="home-radar">
				@SectionHeader("Release Radar", "Out this week · "+d.Radar.Range, "/release-radar", "Full radar")
				@GameCardRow(d.Radar.Cards)
				if len(d.Radar.Upcoming) > 0 {
					<h3 class="mt-8 font-display text-sm font-semibold tracking-widest text-zinc-500 uppercase">Coming up</h3>
					<div class="mt-4">
						@GameCardRow(d.Radar.Upcoming)
					</div>
				} else if len(d.Radar.Recent) > 0 {
					<h3 class="mt-8 font-display text-sm font-semibold tracking-widest text-zinc-500 uppercase">Recently released</h3>
					<div class="mt-4">
						@GameCardRow(d.Radar.Recent)
					</div>
				}
			</section>
		}

		if len(d.Top.Cards) > 0 {
			<section class="container-site mt-16" aria-labelledby="home-top">
				@SectionHeader("Top of the Month", d.Top.Label, d.Top.Href, "Full ranking")
				<ol class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
					for i, card := range d.Top.Cards {
						<li class="relative">
							@GameCardItem(card, true)
							<span class="absolute -top-2 -left-2 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-brass-400 font-display text-sm font-bold text-night-950 shadow-md" aria-hidden="true">
								{ rankLabel(i) }
							</span>
						</li>
					}
				</ol>
			</section>
		}

		if len(d.Gems) > 0 {
			<section class="container-site mt-16" aria-labelledby="home-gems">
				@SectionHeader("Curated Gems", "All-time highest rated", "/top", "Browse tops")
				@GameCardGrid(d.Gems)
			</section>
		}

		<section class="container-site mt-16" aria-label="Newsletter">
			<div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-gem-700/60 via-night-800 to-night-900 px-6 py-12 ring-1 ring-gem-500/20 sm:px-12">
				<div class="pointer-events-none absolute -top-16 -right-16 h-48 w-48 rounded-full bg-gem-500/20 blur-3xl" aria-hidden="true"></div>
				<div class="relative max-w-xl">
					<h2 class="font-display text-2xl font-bold text-white sm:text-3xl">Never miss a gem</h2>
					<p class="mt-2 text-zinc-400">The Release Radar, our Game of the Day picks and the Top of the Month — in your inbox every week. No algorithm, no noise, just gems.</p>
					<div class="mt-6 max-w-md">
						@NewsletterSignup(NewsletterFormState{}, "home")
					</div>
				</div>
			</div>
		</section>
	}
}

// PickHero is the full-width Game of the Day band; used on the home page
// (feature=true, big CTA into the game page) and on the GOTD page.
templ PickHero(pick PickFeature, feature bool) {
	<section class="relative overflow-hidden border-b border-white/5">
		<div class="absolute inset-0" aria-hidden="true">
			if pick.Card.MediaKey != "" {
				<img
					src={ MediaURL(pick.Card.MediaKey) }
					alt=""
					width="460"
					height="215"
					fetchpriority={ fetchPriority(feature) }
					class="h-full w-full scale-105 object-cover blur-[1px]"
				/>
			} else {
				<div class="h-full w-full" style={ TileGradient(pick.Card.Slug) }></div>
			}
			<div class="absolute inset-0 bg-gradient-to-t from-night-950 via-night-950/80 to-night-950/40"></div>
			<div class="absolute inset-0 bg-gradient-to-r from-night-950/80 to-transparent"></div>
		</div>
		<div class={ templ.Classes("container-site relative", templ.KV("pt-20 pb-16 sm:pt-28 sm:pb-24", feature), templ.KV("pt-14 pb-12 sm:pt-20", !feature)) }>
			<div class="max-w-3xl">
				<p class="flex items-center gap-2 text-xs font-semibold tracking-widest text-gem-300 uppercase">
					@GemMark("h-4 w-4")
					Game of the Day · { pick.PickDate.Format("Monday, January 2, 2006") }
				</p>
				<h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">{ pick.Card.Title }</h1>
				if pick.Card.Tagline != "" {
					<p class="mt-3 text-lg text-zinc-300 sm:text-xl">{ pick.Card.Tagline }</p>
				}
				<div class="mt-5 flex flex-wrap items-center gap-3">
					@ReleaseBadge(pick.Card)
					if pick.Card.DeveloperSlug != "" {
						<a href={ "/developers/" + pick.Card.DeveloperSlug } class="text-sm text-zinc-300 transition hover:text-gem-300">
							by { pick.Card.DeveloperName }
						</a>
					}
				</div>
				<div class="mt-8 flex flex-wrap items-center gap-6">
					<div class="flex items-center gap-4">
						@GemScoreBadge(pick.Card.GemScore.Float32, pick.Card.GemScore.Valid)
						<div class="text-sm">
							<p class="font-semibold text-white">Gem score</p>
							<p class="text-zinc-400">editorial + Steam reviews</p>
						</div>
					</div>
					<a href={ "/games/" + pick.Card.Slug } class={ ButtonClass("", "lg", "") }>
						Read why it's a gem
						<span aria-hidden="true">→</span>
					</a>
					@StoreButtonsBar(pick.Stores, "")
				</div>
			</div>
		</div>
	</section>
}

// rankLabel renders the 1-based rank digit for the top list.
func rankLabel(i int) string {
	return strconv.Itoa(i + 1)
}

func fetchPriority(aboveFold bool) string {
	if aboveFold {
		return "high"
	}
	return ""
}
