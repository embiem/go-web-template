package view

import (
	"github.com/embiem/indie-game-gems/util"
)

templ PickPage(d PickPageData) {
	@Layout(d.Meta) {
		@PickHero(d.Pick, false)

		<section class="container-site mt-12">
			<div class="relative overflow-hidden rounded-3xl bg-night-900/70 p-6 ring-1 ring-white/10 sm:p-8">
				<h2 class="flex items-center gap-2.5 font-display text-xl font-bold text-white">
					@GemMark("h-5 w-5")
					Why today's pick?
				</h2>
				<div class="prose-gem mt-3 text-lg">
					if d.Pick.NoteMd != "" {
						@templ.Raw(util.MdToHTML(d.Pick.NoteMd))
					} else {
						<p>The editors let the game speak for itself today.</p>
					}
				</div>
				<div class="mt-6">
					@StoreButtonsBar(d.Pick.Stores, "md")
				</div>
			</div>
		</section>

		<section class="container-site mt-10">
			@Pager(
				PagerLink{Label: "Previous pick", Href: d.Prev},
				PagerLink{Label: "Next pick", Href: d.Next},
				"Game of the Day navigation",
			)
		</section>

		if len(d.Archive) > 0 {
			<section class="container-site mt-14" aria-labelledby="archive-h">
				@SectionHeader("Archive", "Recent picks", "", "")
				<ol class="divide-y divide-white/5 overflow-hidden rounded-2xl bg-night-900/60 ring-1 ring-white/10">
					for _, p := range d.Archive {
						<li>
							<a href={ "/game-of-the-day/" + p.PickDate.Time.Format("2006-01-02") } class="group flex items-baseline gap-4 px-5 py-3 transition hover:bg-white/5">
								<span class="w-28 shrink-0 font-mono text-xs text-zinc-500 tabular-nums">{ p.PickDate.Time.Format("Mon, Jan 2") }</span>
								<span class="font-medium text-zinc-200 transition group-hover:text-gem-300">{ p.GameCard.Title }</span>
							</a>
						</li>
					}
				</ol>
			</section>
		}
	}
}

