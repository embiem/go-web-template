package view

type SignupInputErrors struct {
	PreviousName  string
	NameError     string
	PasswordError string
}

templ SignupPage() {
	@Layout() {
		<div>
			<h1>Signup</h1>
			@SignupForm(SignupInputErrors{})
		</div>
	}
}

templ SignupForm(errors SignupInputErrors) {
	<form hx-post="/signup" hx-swap="outerHTML">
		<input
			name="username"
			type="text"
			placeholder="Your username"
			value={ errors.PreviousName }
			autocomplete="username"
			maxlength="64"
			required
		/>
		if errors.NameError != "" {
			<div class="text-red-500">{ errors.NameError }</div>
		}
		<input
			name="password"
			type="password"
			placeholder="Your password"
			autocomplete="new-password"
			minlength="8"
			maxlength="72"
			required
		/>
		if errors.PasswordError != "" {
			<div class="text-red-500">{ errors.PasswordError }</div>
		}
		<div class="hidden">
			<input name="organization" type="text" placeholder="Your organization" tabindex="-1" autocomplete="off"/>
		</div>
		@Button(ButtonProps{Type: "submit"}) {
			Signup 
		}
	</form>
}

type LoginInputErrors struct {
	PreviousName  string
	NameError     string
	PasswordError string
	// FormError is the deliberately generic credential failure: telling the
	// user which half was wrong is a username oracle.
	FormError string
}

templ LoginPage() {
	@Layout() {
		<div>
			<h1>Login</h1>
			<p>Don't have an account yet? <a href="/signup">Sign-up!</a></p>
			@LoginForm(LoginInputErrors{})
		</div>
	}
}

templ LoginForm(errors LoginInputErrors) {
	<form hx-post="/login" hx-swap="outerHTML">
		<input
			name="username"
			type="text"
			placeholder="Your username"
			value={ errors.PreviousName }
			autocomplete="username"
			maxlength="64"
			required
		/>
		if errors.NameError != "" {
			<div class="text-red-500">{ errors.NameError }</div>
		}
		<input
			name="password"
			type="password"
			placeholder="Your password"
			autocomplete="current-password"
			maxlength="72"
			required
		/>
		if errors.PasswordError != "" {
			<div class="text-red-500">{ errors.PasswordError }</div>
		}
		if errors.FormError != "" {
			<div class="text-red-500">{ errors.FormError }</div>
		}
		<div class="hidden">
			<input name="organization" type="text" placeholder="Your organization" tabindex="-1" autocomplete="off"/>
		</div>
		@Button(ButtonProps{Type: "submit"}) {
			Login 
		}
	</form>
}

templ LogoutForm() {
	<form action="/logout" method="post">
		@Button(ButtonProps{Type: "submit"}) {
			Logout 
		}
	</form>
}
