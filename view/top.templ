package view

templ TopPage(d TopPageData) {
	@Layout(d.Meta) {
		<section class="container-site pt-12 sm:pt-16">
			<p class="text-xs font-semibold tracking-widest text-gem-400 uppercase">Top of the Month</p>
			<h1 class="mt-2 font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">{ d.Label }</h1>
			<p class="mt-1 text-zinc-400">Ranked by gem score — our blend of editorial rating and Steam reviews.</p>
			<div class="mt-6">
				@Pager(d.Prev, d.Next, "Month navigation")
			</div>
		</section>

		<section class="container-site mt-10 pb-4" aria-label="Ranked games">
			if len(d.Cards) == 0 {
				@EmptyState(
					"No ranked releases this month",
					"Nothing we've scored came out in this month yet. Browse the previous or next month.",
					"/release-radar",
					"Open the Release Radar",
				)
			} else {
				<ol class="space-y-4">
					for i, card := range d.Cards {
						<li>
							<a href={ "/games/" + card.Slug } class="group flex items-center gap-4 rounded-2xl bg-night-900 p-3 ring-1 ring-white/10 transition duration-200 hover:bg-night-800 hover:ring-gem-500/50">
								<span class="w-8 shrink-0 text-center font-display text-2xl font-bold text-brass-400 tabular-nums">{ rankLabel(i) }</span>
								<div class="relative aspect-460/215 w-32 shrink-0 overflow-hidden rounded-lg sm:w-44">
									@GameCardMedia(card)
								</div>
								<div class="min-w-0 flex-1">
									<h2 class="truncate font-display text-lg font-bold text-white transition group-hover:text-gem-300">{ card.Title }</h2>
									<p class="mt-0.5 truncate text-sm text-zinc-500">
										if card.DeveloperSlug != "" {
											{ card.DeveloperName }
											<span aria-hidden="true"> · </span>
										}
										{ ReleaseBadgeText(card.ReleaseStatus, card.ReleaseDate) }
									</p>
									if card.Tagline != "" {
										<p class="mt-1 hidden line-clamp-1 text-sm text-zinc-400 sm:block">{ card.Tagline }</p>
									}
								</div>
								<div class="shrink-0 pr-1">
									@GemScoreBadge(card.GemScore.Float32, card.GemScore.Valid)
								</div>
							</a>
						</li>
					}
				</ol>
			}
		</section>
	}
}
